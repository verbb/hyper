{
    "name": "verbb/hyper",
    "description": "A user-friendly links field for Craft.",
    "type": "craft-plugin",
    "version": "3.0.0-beta.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "hyper"
    ],
    "support": {
        "email": "support@verbb.io",
        "issues": "https://github.com/verbb/hyper/issues?state=open",
        "source": "https://github.com/verbb/hyper",
        "docs": "https://github.com/verbb/hyper",
        "rss": "https://github.com/verbb/hyper/commits/beta.atom"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Verbb",
            "homepage": "https://verbb.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.9",
        "embed/embed": "^4.0.0",
        "nystudio107/craft-plugin-vite": "^5.0.0",
        "verbb/base": "^3.0.0"
    },
    "require-dev": {
        "craftcms/cms": "^5.9",
        "craftcms/generator": "^2.0.0",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin": "^3.0",
        "vlucas/phpdotenv": "^5.6",
        "yiisoft/yii2-shell": "^2.0.3",
        "craftcms/feed-me": "^6.0",
        "verbb/vizy": "3.2.7"
    },
    "autoload": {
        "psr-4": {
            "verbb\\hyper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true,
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "test:baseline": "ddev test --task=capture-baselines",
        "test:baseline:wired": "ddev test --task=capture-wired-baselines",
        "test:baseline:save": "ddev test --task=capture-save-baselines",
        "test:baseline:assert": "ddev test --task=assert-baselines",
        "test:baseline:check": "ddev test --suite=baseline",
        "test": "ddev test",
        "test:all": "ddev test --suite=all",
        "test:perf": "ddev test --suite=performance"
    },
    "extra": {
        "name": "Hyper",
        "handle": "hyper",
        "changelogUrl": "https://raw.githubusercontent.com/verbb/hyper/beta/CHANGELOG.md",
        "class": "verbb\\hyper\\Hyper"
    }
}
