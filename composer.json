{
    "name": "verbb/hyper",
    "description": "A user-friendly links field for Craft.",
    "type": "craft-plugin",
    "version": "3.0.0-beta.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "hyper"
    ],
    "support": {
        "email": "support@verbb.io",
        "issues": "https://github.com/verbb/hyper/issues?state=open",
        "source": "https://github.com/verbb/hyper",
        "docs": "https://github.com/verbb/hyper",
        "rss": "https://github.com/verbb/hyper/commits/v2.atom"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Verbb",
            "homepage": "https://verbb.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0",
        "embed/embed": "^3.0.0 || ^4.0.0",
        "nystudio107/craft-plugin-vite": "^5.0.0",
        "verbb/base": "^3.0.0"
    },
    "require-dev": {
        "craftcms/cms": "^5.9",
        "craftcms/generator": "^2.0.0",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin": "^3.0",
        "vlucas/phpdotenv": "^5.6",
        "yiisoft/yii2-shell": "^2.0.3"
    },
    "autoload": {
        "psr-4": {
            "verbb\\hyper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true,
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest --bootstrap tests/bootstrap-craft.php -c phpunit.craft.xml tests/Services --exclude-group=slow --exclude-group=perf",
        "test:setup": "@php tests/bin/test-setup.php",
        "test:perf": "./vendor/bin/pest --bootstrap tests/bootstrap-craft.php -c phpunit.craft.xml tests --group=perf",
        "test:baseline": "@php tests/bin/capture-baselines.php",
        "test:baseline:wired": "@php tests/bin/capture-wired-baselines.php",
        "test:baseline:save": "@php tests/bin/capture-save-baselines.php",
        "test:baseline:assert": "@php tests/bin/assert-baselines.php",
        "test:baseline:check": "./vendor/bin/pest --bootstrap tests/bootstrap-craft.php -c phpunit.craft.xml tests/Performance/BaselineRegressionTest.php --group=baseline",
        "test:all": "./vendor/bin/pest --bootstrap tests/bootstrap-craft.php -c phpunit.craft.xml tests"
    },
    "extra": {
        "name": "Hyper",
        "handle": "hyper",
        "changelogUrl": "https://raw.githubusercontent.com/verbb/hyper/craft-5/CHANGELOG.md",
        "class": "verbb\\hyper\\Hyper"
    }
}